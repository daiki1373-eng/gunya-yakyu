{
  "rules": {
    ".read": false,
    ".write": false,
    "teams": {
      "$code": {
        ".read": true,
        ".write": "auth != null && (!data.exists() || data.child('owner').val() === auth.uid)",
        ".validate": "$code.matches(/^[0-9]{6}$/) && newData.child('owner').val() === auth.uid && newData.child('name').isString() && newData.child('name').val().length <= 20 && newData.child('lineup').hasChildren(['0','1','2','3','4','5','6','7','8']) && !newData.child('lineup').child('9').exists() && newData.child('pitcher').isString()"
      }
    }
  }
}
